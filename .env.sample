# SkTorrent auth
SKT_USERNAME=
SKT_PASSWORD=

# OIDC Configuration
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_OIDC_ISSUER_URL=https://authentik.your.domain/application/o/skt-proxy/

# Domain & Security
OAUTH2_PROXY_COOKIE_SECRET=your_generated_cookie_secret_here
OAUTH2_PROXY_COOKIE_DOMAIN=skt-proxy.your.domain
OAUTH2_PROXY_REDIRECT_URL=https://skt.your.domain/oauth2/callback

# Authorization
# Change '*' to 'rodinny.cloud' to only allow your family's emails
OAUTH2_PROXY_EMAIL_DOMAINS=* ```

# Synology Integration
SYNOLOGY_URL=http://192.168.1.100:5000
SYNOLOGY_USER=
SYNOLOGY_PASSWORD=
SYNOLOGY_DSM_VERSION=7
